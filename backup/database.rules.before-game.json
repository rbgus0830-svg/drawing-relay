{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$roomCode": {
        ".write": "auth != null && !data.exists() && newData.exists() && $roomCode.matches(/^[A-HJ-NP-Z2-9]{4}$/) && newData.child('hostUid').val() === auth.uid",

        ".validate": "newData.hasChildren(['hostUid', 'meta'])",

        "hostUid": {
          ".read": "auth != null",
          ".validate": "newData.isString() && newData.val() === auth.uid && (!data.exists() || newData.val() === data.val())"
        },

        "meta": {
          ".read": "auth != null",

          ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid && newData.exists()",

          ".validate": "newData.hasChildren(['type', 'status', 'maxPlayers', 'relaySteps', 'stepDurationMs', 'createdAt']) && ((newData.child('type').val() === 'class' && newData.child('maxPlayers').val() === 30) || (newData.child('type').val() === 'group' && newData.child('maxPlayers').val() === 5))",

          "type": {
            ".validate": "newData.isString() && (newData.val() === 'class' || newData.val() === 'group') && (!data.exists() || newData.val() === data.val())"
          },

          "status": {
            ".validate": "newData.isString() && (newData.val() === 'LOBBY' || newData.val() === 'PLAYING' || newData.val() === 'FINISHED')"
          },

          "maxPlayers": {
            ".validate": "newData.isNumber() && (newData.val() === 5 || newData.val() === 30) && (!data.exists() || newData.val() === data.val())"
          },

          "relaySteps": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20 && (!data.exists() || newData.val() === data.val())"
          },

          "stepDurationMs": {
            ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 3600000 && (!data.exists() || newData.val() === data.val())"
          },

          "createdAt": {
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
          },

          "$other": {
            ".validate": false
          }
        },

        "players": {
          ".read": "auth != null && data.parent().child('hostUid').val() === auth.uid",

          "$studentNumber": {
            ".read": "auth != null",

            ".write": "auth != null && newData.exists() && (((!data.exists()) && data.parent().parent().child('meta').child('status').val() === 'LOBBY' && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid && newData.child('uid').val() === auth.uid)) && ((data.parent().parent().child('meta').child('type').val() === 'class' && $studentNumber.matches(/^(0[1-9]|[12][0-9]|30)$/)) || (data.parent().parent().child('meta').child('type').val() === 'group' && $studentNumber.matches(/^0[1-5]$/)))",

            ".validate": "newData.hasChildren(['uid', 'number', 'joinedAt', 'connected'])",

            "uid": {
              ".validate": "newData.isString() && newData.val() === auth.uid && (!data.exists() || newData.val() === data.val())"
            },

            "number": {
              ".validate": "newData.isString() && newData.val() === $studentNumber && (!data.exists() || newData.val() === data.val())"
            },

            "joinedAt": {
              ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
            },

            "connected": {
              ".validate": "newData.isBoolean()"
            },

            "$other": {
              ".validate": false
            }
          }
        },

        "$other": {
          ".validate": false
        }
      }
    }
  }
}